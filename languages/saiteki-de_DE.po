msgstr "Video-Erweiterung der Sitemap"

msgid "JSON-LD Schema"
msgstr "JSON-LD-Schema"

msgid "Twitter Player Cards"
msgstr "Twitter Player Cards"

msgid "Dynamic Titles"
msgstr "Dynamische Titel"

