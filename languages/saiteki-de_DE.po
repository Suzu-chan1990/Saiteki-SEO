msgstr "%1$d / %2$d Module"

msgid "Recommended actions"
msgstr "Empfohlene Schritte"

msgid "Nothing to do. Everything that matters is switched on."
msgstr "Nichts zu tun. Alles Wichtige ist eingeschaltet."

