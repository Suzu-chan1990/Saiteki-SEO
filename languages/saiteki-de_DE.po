msgstr "Pfad ändern"

msgid "Index"
msgstr "Index"

msgid "Pages"
msgstr "Seiten"

msgid "Latest posts"
msgstr "Neueste Beiträge"

msgid "Test reachability"
msgstr "Erreichbarkeit testen"

msgid "The sitemap engine is switched off. WordPress serves its own sitemap instead."
msgstr "Die Sitemap-Engine ist ausgeschaltet. WordPress liefert stattdessen seine eigene Sitemap aus."

msgid "Published videos"
msgstr "Veröffentlichte Videos"

msgid "Posts in the sitemap"
msgstr "Beiträge in der Sitemap"

msgid "Sitemap files"
msgstr "Sitemap-Dateien"

msgid "%s posts per file"
msgstr "%s Beiträge pro Datei"

msgid "Google keys"
msgstr "Google-Keys"

msgid "Rotation active"
msgstr "Rotation aktiv"

msgid "Indexing API"
msgstr "Indexing API"

msgid "On"
msgstr "An"

