msgstr "Wichtig"

msgid "Optional"
msgstr "Optional"

msgid "Recommended"
msgstr "Empfohlen"

msgid "Sitemap"
msgstr "Sitemap"

msgid "Virtual files, generated on request. Nothing is written to disk."
msgstr "Virtuelle Dateien, die beim Abruf erzeugt werden. Es wird nichts auf die Platte geschrieben."

